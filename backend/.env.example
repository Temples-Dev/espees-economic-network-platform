# Copy to .env and adjust for your environment
# Production values must be set in the Docker deployment environment.

DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=api.example.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=
FRONTEND_URL=https://yourapp.example.com
# Espees integration (Doc16 §5, §31). Leave blank until issued.
ESPEES_API_BASE_URL=https://api.espees.org
ESPEES_API_KEY=
ESPEES_MERCHANT_WALLET=
ESPEES_PAYMENT_PORTAL_URL=https://payment.espees.org/pay
ESPEES_VENDING_ENABLED=False
# Public base URL of this backend for per-payment return URLs (falls back to FRONTEND_URL).
BACKEND_PUBLIC_URL=